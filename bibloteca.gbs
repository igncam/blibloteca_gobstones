

procedure PonerUnaDeCada() {
    /*
    PROPÓSITO:  Pone una bolita de cada color en la celda actual
    PRECONDICIONES: niguna
    */

    Poner(Verde)
    Poner(Azul)
    Poner(Negro)
    Poner(Rojo)
}

procedure Poner_DeColor_(cantidadAPoner, colorAPoner){
   /*
    PROPÓSITO:  Pone *cantidadAPóner* bolitas de color *colorAPoner* en la celda actual
    PARÁMETROS:
            * cantidadAPoner: Numeros - Cantidad de bolitas a poner.
            * colorAPoner: Colores - Color de bolitas a poner.
    PRECONDICIONES: niguna
    */
    repeat (cantidadAPoner) {
        Poner(colorAPoner)
    }
}

procedure Mover_VecesAl_(cantidadAMover,direcciónAMover) {
    /*
        PROPÓSITO:  Mueve *cantidadAMover* hacia la direccion *direccioAMover*
        PARÁMETROS:
            * cantidadAMover: Numeros - Cantidad de movimientos.
            * direcciónAMover: Direcciones - Direccion a mover.
        PRECONDICIONES: Debe haber al menos *cantidadAMover* celdas lidantes al *direcciónAMover*
            
    */
    repeat(cantidadAMover){
        Mover(direcciónAMover)
    }
}



procedure Sacar_DeColor_(cantidadASacar,colorASacar) {
    /*
        PROPÓSITO:  Saca *cantidadASacar* bolitas de color *colorASacar* en la celda actual
        PARÁMETROS:
            * cantidadASacar: Numero - Cantidad de bolitas a sacar.
            * colorASacar: Color - Color de bolitas a sacar.
        PRECONDICIONES: Debe haber al menos 1 bolita de *colorASacar*
            
    */
    repeat(cantidadASacar){
        Sacar(colorASacar)
    }
}    

procedure SacarTodasLasDeColor_(colorASacar) {
    /*
        PROPÓSITO:  Saca todas las bolitas de *colorASacar* en la celda actual
        PARÁMETROS:
            * colorASacar: tipo - descripción.
        PRECONDICIONES:Ninguna
    */
    Sacar_DeColor_(nroBolitas(colorASacar),colorASacar)

}

procedure VaciarCelda(){
    /*
        PROPÓSITO:  Saca todas las bolitas de la celda actual.
        PRECONDICIONES: Ninguno
    */
    SacarTodasLasDeColor_(Rojo)
    SacarTodasLasDeColor_(Negro) 
    SacarTodasLasDeColor_(Azul) 
    SacarTodasLasDeColor_(Verde)  
}

procedure MoverDiagonalAl_Y_(primeraDireccion, segundaDireccion){
    
    /*
    PROPOSITO: Mueve el cabezal hacia la celda en diagonal hacia *primeraDireccion*
    y *segundaDireccion*.
    PRECONDICIONES: 
    *Debe haber al menos una celda hacia *primeraDireccion*
    *Debe haber al menos una celda hacia *segundaDireccion*
    **primeraDireccion* y *segundaDireccion* no puede ser opuestas ni iguales.
    */
    
    Mover(primeraDireccion)
    Mover(segundaDireccion)
}

procedure Poner_Si_(color,condicion){
    /*
        PROPOSITO: Pone una bolita *color* si *condicion* se cumple
        PARÁMETROS:
            * color: Color - Color de bolita a poner.
            * condicion: Bool - Condicion a evaluar para poner bolita
    */
    if(condicion) then{
        Poner(color)
    }
}

procedure Sacar_Si_(color,condicion){
    /*
        PROPOSITO: Quita una bolita *color* si *condicion* se cumple
        PARÁMETROS:
            * color: Color - Color de bolita a quitar.
            * condicion: Bool - Condicion a evaluar para quitar bolita
    */
    if(condicion) then{
        Sacar(color)
    }
}


procedure Mover_Si_(direccion,condicion){
    /*
        PROPOSITO: Mueve una posicion al *direccion* solo si *condicion* se cumple
        PARÁMETROS:
            * direccion: Dirreccion - Direccion a mover.
            * condicion: Bool - Condicion a evaluar
        PRECONDICION: 
            * Debe existir una posicion al *direccion* a mover.
    */
    if(condicion) then{
        Mover(direccion)
    }
}

function esCeldaVacía(){
    /*
        PROPÓSITO: Indica si la celda actual esta vacia.
        TIPO: Bool
    */
    
    return (not hayBolitas(Verde) && not hayBolitas(Azul) && not hayBolitas(Negro) && not hayBolitas(Rojo))
}

function tieneUnaDeCada(){
    /*
        PROPÓSITO: Indica si la celda actual tiene al menos una bolita de cada color.
        TIPO: Bool
    */
    
    return (hayBolitas(Verde) &&  hayBolitas(Azul) &&  hayBolitas(Negro) &&  hayBolitas(Rojo))
}


function esCeldaConBolitas(){
    /*
        PROPÓSITO: Indica si la celda actual tiene al menos una bolita sin importar el color.
        TIPO: Bool
    */

    return (hayBolitas(Verde) ||  hayBolitas(Azul) ||  hayBolitas(Negro) ||  hayBolitas(Rojo))
}

procedure IrAPrimeraCeldaEnUnRecorridoAl_Y_(dirPrincipal, dirSecundaria){
    /*
        PROPÓSITO: Mueve el cabezal a la primera celda de un recorido en direccion *dirPrincipal* y *dirSecundaria* 
        PARÁMETROS:
            * dirPrincipal: Dirreccion - Primera direccion a mover.
            * dirSecundaria: Dirreccion - Segunda direccion a mover.
        PRECONDICIONES:
            *  **dirPrincipal** y **dirSecundaria** no pueden ser iguales
            *  **dirPrincipal** y **dirSecundaria** no pueden ser opuestas
    */
    
            IrAlBorde(opuesto(dirPrincipal))
            IrAlBorde(opuesto(dirSecundaria))
}

function haySiguienteCeldaEnUnRecorridoAl_Y_(dirPrincipal, dirSecundaria){
    /*
        PROPÓSITO: Indica si el cabezal se puede mover hacia el *dirPrincipal* o *dirSecundaria* 
        PARÁMETROS:
            * dirPrincipal: Dirreccion - Primera direccion a evaluar.
            * dirSecundaria: Dirreccion - Segunda direccion a evaluar.
        PRECONDICIONES:
            *  **dirPrincipal** y **dirSecundaria** no pueden ser iguales
            *  **dirPrincipal** y **dirSecundaria** no pueden ser opuestas
    */

    return(puedeMover(dirPrincipal) ||puedeMover(dirSecundaria))
}

procedure IrASiguienteCeldaEnUnRecorridoAl_Y_(dirPrincipal, dirSecundaria){
    /*
        PROPÓSITO: Mueve el cabezal en la siguiente celda de un recorido en direccion *dirPrincipal* y *dirSecundaria* 
        PARÁMETROS:
            * dirPrincipal: Dirreccion - Primera direccion a mover.
            * dirSecundaria: Dirreccion - Segunda direccion a mover.
        PRECONDICIONES:
            *  **dirPrincipal** y **dirSecundaria** no pueden ser iguales
            *  **dirPrincipal** y **dirSecundaria** no pueden ser opuestas
    */

    if(puedeMover(dirPrincipal)){
        Mover(dirPrincipal)
    }else{
        IrAlBorde(opuesto(dirPrincipal))
        Mover(dirSecundaria)
    }          
}



function hayBolitas_EnCeldaAl_(color,direccion){
    
    /*
        PROPÓSITO: Indica si existen bolitas de color *color* en la direccion *direccion* lindante. 
        PARÁMETROS:
            * color: Color - Color a consultar.
            * direccion: Dirreccion - Direccion a consultar.
        PRECONDICIONES:
            * Debe existir una celda lindante hacia **direccion**
        TIPO: Booleano
              
    */
    
    Mover(direccion)
    return(hayBolitas(color))
}



function hayBolitas_Al_(color,direccion){
    
    /*
        PROPÓSITO: Indica si existen bolitas de color *color* en la direccion *direccion* lindante. 
        PARÁMETROS:
            * color: Color - Color a consultar.
            * direccion: Dirreccion - Direccion a consultar.
        PRECONDICIONES:
            * Ninguna
        TIPO: Booleano      
    */
        return(puedeMover(direccion) && hayBolitas_EnCeldaAl_(color,direccion))
}
